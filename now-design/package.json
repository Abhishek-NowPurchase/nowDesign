{
  "name": "now-design",
  "version": "1.0.0",
  "description": "Design system monorepo",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "storybook": "start-storybook -p 6006",
    "build-storybook": "build-storybook -o storybook-static",
    "build:all": "npm run build:atoms && npm run build:molecules && npm run build:organisms && npm run build:icons && npm run build:tokens && npm run build:styles && npm run build:theme",
    "build:atoms": "cd packages/atoms && npm run build",
    "build:molecules": "cd packages/molecules && npm run build",
    "build:organisms": "cd packages/organisms && npm run build",
    "build:icons": "cd packages/icons && npm run build",
    "build:tokens": "cd packages/tokens && npm run build",
    "build:styles": "cd packages/styles && npm run build",
    "build:theme": "cd packages/theme && npm run build"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@storybook/addon-docs": "6.5.16",
    "@storybook/addon-essentials": "6.5.16",
    "@storybook/addon-interactions": "6.5.16",
    "@storybook/builder-webpack4": "6.5.16",
    "@storybook/jest": "^0.2.2",
    "@storybook/manager-webpack4": "6.5.16",
    "@storybook/react": "6.5.16",
    "@storybook/testing-library": "^0.2.1",
    "@testing-library/user-event": "^14.6.1",
    "babel-loader": "^8.2.5",
    "css-loader": "^3.6.0",
    "style-loader": "^1.3.0"
  }
}
